{
  "name": "productforge",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "postinstall": "node scripts/fix-swc-wasm.mjs",
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-money-floats.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:test": "node scripts/db.mjs test",
    "db:reset": "node scripts/db.mjs reset",
    "test": "vitest run",
    "test:money": "vitest run tests/money",
    "test:rls": "vitest run --passWithNoTests tests/rls",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "next": "^15.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "15.5.23",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
