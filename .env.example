# =====================================================================
# ProductForge environment. Copy to .env.local and fill in.
# Variables marked SERVER ONLY must NEVER be prefixed NEXT_PUBLIC_ —
# CI greps the client bundle for them and fails the build on a hit.
# =====================================================================

# --- App -------------------------------------------------------------
# Public base URL of the app (used in emails, links, referral URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data backend for screens: "mock" (in-memory fixtures) or "supabase" (Phase 2+).
DATA_BACKEND=mock

# --- Supabase (https://supabase.com/dashboard → project settings → API)
# Public: safe in the client, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never NEXT_PUBLIC_. Bypasses RLS; ledger writes use this.
SUPABASE_SERVICE_ROLE_KEY=

# Local Postgres for migrations/tests (Supabase CLI default shown).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Stripe (https://dashboard.stripe.com/apikeys) -------------------
# Public: publishable key, safe in the client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SERVER ONLY — never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# SERVER ONLY — never NEXT_PUBLIC_. From `stripe listen` locally, or the
# webhook endpoint settings in the dashboard.
STRIPE_WEBHOOK_SECRET=
# SERVER ONLY — the separate signing secret for the Connect webhook endpoint.
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Anthropic (https://console.anthropic.com/settings/keys) ---------
# SERVER ONLY — never NEXT_PUBLIC_. Generation runs server-side only.
ANTHROPIC_API_KEY=

# --- Resend (https://resend.com/api-keys) ----------------------------
# SERVER ONLY.
RESEND_API_KEY=

# --- VirusTotal (https://www.virustotal.com/gui/my-apikey) -----------
# SERVER ONLY. Used by the safety pipeline (a Vercel function).
# Free tier: 4 req/min, 500/day — exhaustion blocks publishing with retry.
VIRUSTOTAL_API_KEY=
# SERVER ONLY. Google Cloud project → enable Safe Browsing API → create key.
GOOGLE_SAFE_BROWSING_KEY=

# --- Observability ----------------------------------------------------
# Sentry project DSN (server + client error reporting).
SENTRY_DSN=
# PostHog project key — public by design.
NEXT_PUBLIC_POSTHOG_KEY=

# --- Cron / internal -------------------------------------------------
# SERVER ONLY. Shared secret protecting /api/cron/* endpoints.
CRON_SECRET=
# SERVER ONLY. Rotating salt for sha256(ip + salt) hashing. Rotate quarterly.
IP_HASH_SALT=
# SERVER ONLY. Signing key for download/link JWTs (24h TTL, revocable jti).
DELIVERY_TOKEN_SECRET=
